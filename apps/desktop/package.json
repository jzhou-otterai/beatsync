{
  "name": "desktop",
  "productName": "Beatsync Speaker",
  "version": "0.1.0",
  "private": true,
  "description": "Stream your Mac's system audio into a Beatsync room",
  "main": "dist/main.js",
  "scripts": {
    "build:native": "bash scripts/build-native.sh",
    "build:server": "bash scripts/build-server.sh",
    "build:app": "bun run build:native && bun run build:server && bun run bundle",
    "bundle": "bun build src/main.ts src/preload.ts src/calibrationPreload.ts --target=node --format=cjs --outdir=dist --external electron --sourcemap",
    "app": "bun run build:app && bash scripts/ensure-electron.sh && electron .",
    "dist": "bun run build:app && bash scripts/ensure-electron.sh && bash scripts/dist.sh",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@beatsync/shared": "workspace:*",
    "@types/bun": "1.3.14",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "typescript": "6.0.3"
  },
  "build": {
    "appId": "gg.beatsync.speaker",
    "productName": "Beatsync Speaker",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "renderer/**",
      "resources/*.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin/beatsync-audio-capture",
        "to": "bin/beatsync-audio-capture"
      },
      {
        "from": "build/Beatsync.driver",
        "to": "driver/Beatsync.driver"
      },
      {
        "from": "bin/beatsync-server",
        "to": "bin/beatsync-server"
      },
      {
        "from": "build/web",
        "to": "web"
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "minimumSystemVersion": "13.0",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Beatsync Speaker reads the Beatsync audio device (what your Mac plays to it) to stream it to your room."
      },
      "icon": "resources/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "notarize": false
    },
    "afterPack": "scripts/after-pack.cjs",
    "dmg": {
      "title": "Beatsync Speaker",
      "icon": "resources/icon.icns",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 180
        },
        {
          "x": 400,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
